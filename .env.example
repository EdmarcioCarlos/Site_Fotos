# Modelo de configuração. Copie para .env.local e preencha lá.
# NUNCA coloque valores reais neste arquivo: ele vai para o GitHub.

# Conexão Postgres do Neon (use a URL com "-pooler").
DATABASE_URL=

# Token do Vercel Blob (criado junto com o Blob store).
BLOB_READ_WRITE_TOKEN=

# Chave da Maps Embed API. Ela fica visível no navegador por natureza, por isso
# deve ser restrita no Google Cloud ao domínio do site e somente à Maps Embed API.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
